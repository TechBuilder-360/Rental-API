# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME=rental-api
APP_ENV=development
APP_PORT=8080

# ==============================================================================
# Logger Configuration
# ==============================================================================
# Options: trace, debug, info, warn, error, fatal, panic
LOG_LEVEL=info
LOG_PRETTY=true

# ==============================================================================
# PostgreSQL Database
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rental
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_MAX_LIFETIME=30m
POSTGRES_AUTO_MIGRATE=false

# ==============================================================================
# Redis Cache & Sessions
# ==============================================================================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=10

# ==============================================================================
# Temporal.IO
# ==============================================================================
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=rental-task-queue

# ==============================================================================
# Authentication (JWT & OTP)
# ==============================================================================
# JWT secret must be at least 32 bytes
JWT_SECRET=replace-with-a-secure-random-32-byte-secret-key
JWT_ISSUER=rental-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
BCRYPT_COST=12

# OTP settings
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_DELAY=60s

# ==============================================================================
# Transactional Email (Brevo / Postmark / Log)
# ==============================================================================
# Options: "log" (logs to stdout for local dev), "brevo", or "postmark"
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@rental.local
EMAIL_FROM_NAME="Rental API"

# Brevo configuration (when EMAIL_PROVIDER=brevo)
BREVO_API_KEY=

# Postmark configuration (when EMAIL_PROVIDER=postmark)
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

# ==============================================================================
# Didit User Identity Verification (KYC/KYB)
# ==============================================================================
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_BASE_URL=https://verification.didit.me
